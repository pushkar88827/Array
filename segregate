#include <iostream>
#include <vector>
using namespace std;

void segregate(vector<int>& arr) {
    int count0 = 0;

    for(int x : arr) {
        if(x == 0)
            count0++;
    }

    for(int i = 0; i < arr.size(); i++) {
        if(i < count0)
            arr[i] = 0;
        else
            arr[i] = 1;
    }
}

int main(){
    vector<int> arr={0,1,0,1,0,1,0,1};
    segregate(arr);
    for(int x : arr){
        cout<<x<<" ";
    }   
}
