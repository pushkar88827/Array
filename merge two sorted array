#include <iostream>
using namespace std;

int main() {
    int a[] = {20, 40, 60, 80, 100};
    int b[] = {10, 30, 50, 70, 90};

    int m = sizeof(a) / sizeof(a[0]);
    int n = sizeof(b) / sizeof(b[0]);

    int c[m + n];

    int i = 0, j = 0, k = 0;

    while (i < m && j < n) {
        if (a[i] < b[j]) {
            c[k] = a[i];
            i++;
            k++;
        }
        else {
            c[k] = b[j];
            j++;
            k++;
        }
    }

    // Remaining elements of a
    while (i < m) {
        c[k] = a[i];
        i++;
        k++;
    }

    // Remaining elements of b
    while (j < n) {
        c[k] = b[j];
        j++;
        k++;
    }

    for (int k = 0; k < m + n; k++) {
        cout << c[k] << " ";
    }

    return 0;
}
