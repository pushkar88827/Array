#include <iostream>
#include <vector>
using namespace std;

int main(){

vector<int> v={5,4,2,5,3};
for(int i=0;i<v.size();i++){
    cout<<v[i]<<" "<<endl;

}
for(int ele : v){     // element can be printed in only one order
    if(ele%2==0){
        ele=ele*2;
        cout<<ele<<" ";
    }
    else{
    cout<<ele<<" ";
    }
}
}
