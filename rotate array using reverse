#include <iostream>
#include <vector>
using namespace std;

void reverse(vector<int>& array,int start,
    int end){
    
    while(start<end){
        swap(array[start],array[end]);
        start++;
        end--;
    }
}

   
int main() {
    vector<int> array = {23,25,27,29,31,33};

    int n=array.size();
    int k=3;
    k=k%n;

    reverse(array,0,n-1);  
    
    reverse(array,0,k-1);

    reverse(array,k,n-1);

    for (int x : array) {
        cout << x << " ";
    }
    return 0;
}
